# Rendered by secret_drop.py render-unit through install.sh; do not edit.
[Unit]
Description=One-time secret drop form

[Service]
Type=simple
ExecStart=@PYTHON@ @SCRIPT@ --settings @SETTINGS@ serve
Restart=no
TimeoutStopSec=10
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@SCRIPT_DIR@ @SETTINGS@
BindPaths=@SLOTS_DIR@ @ALLOWED_DIRS@
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
